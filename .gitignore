# 密钥文件（最重要！）
.env
.env.*
*.key

# Python 虚拟环境
.venv/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# 数据与模型（体积大，不上传）
data/raw/*
data/index/*
models/
*.bin
*.pt
*.safetensors

# 编辑器
.vscode/
.idea/

# 系统
.DS_Store
Thumbs.db

# 例外：.env.example 是模板，需要进 git
!.env.example
